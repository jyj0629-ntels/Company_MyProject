# Server
PORT=4100
TZ=Asia/Seoul

# Safety first: true = do not send real orders (recommended while testing)
DRY_RUN=true

# Kiwoom REST API base URL
KIWOOM_BASE_URL=https://api.kiwoom.com

# Kiwoom app credentials (from openapi portal)
KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=

# Account info
KIWOOM_ACCOUNT_NO=
KIWOOM_PRODUCT_CODE=01

# Domestic exchange code: KRX, NXT, SOR
KIWOOM_DOMESTIC_EXCHANGE=KRX

# Optional: use preset access token if you already generated one
KIWOOM_ACCESS_TOKEN=
